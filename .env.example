# VeriChain Production Environment Variables

# Supabase (Auth, Profiles, Persistent Ledger Storage)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# API Configuration (Optional: defaults to relative path in production)
VITE_API_BASE_URL=

# Brevo (Email OTP & Notifications - Server only, never exposed to client)
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=your-verified-sender@example.com

# Server Port (Render sets this dynamically)
PORT=5000
